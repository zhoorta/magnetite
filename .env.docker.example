# Optional: copy to .env.docker (it is git-ignored) when something differs from the defaults. Without it Magnetite starts
# on http://localhost:8080 with a key it makes itself.
APP_NAME=Magnetite
APP_ENV=production
APP_DEBUG=false

# The address people use. Behind HTTPS also set SESSION_SECURE_COOKIE=true so the cookie only travels over it.
APP_URL=https://music.example.com
SESSION_SECURE_COOKIE=true
SESSION_LIFETIME=120

# The first user is normally made in the browser (/setup). To make it from the shell instead, name it here; without a
# password a random one is printed once in the logs. MAGNETITE_SETUP_TOKEN, when set, is asked for on /setup too.
# MAGNETITE_SETUP_TOKEN=
# MAGNETITE_USER=jose
# MAGNETITE_PASSWORD=

# Only to bring your own key (docker compose run --rm app php artisan key:generate --show). Left out, one is made on the
# first start and kept in the data volume.
# APP_KEY=

# Zip uploads. PHP and Caddy follow MAGNETITE_UPLOAD_MAX_MB; a proxy in front (nginx client_max_body_size,
# Cloudflare 100 MB on the free plan) has its own limit.
MAGNETITE_UPLOAD_MAX_MB=2048
MAGNETITE_UPLOAD_MAX_UNPACKED_MB=6144

# Libraries kept in Ferrite (php artisan magnetite:storage): files fetched for scans, conversions and the next track
# are cached in the storage volume up to this size; the oldest go first.
MAGNETITE_CACHE_MAX_GB=10
